# الأسهل: شغّل تطبيق الويب واضغط شارة AI لإضافة المفتاح من الواجهة.
# الملف ده للمستخدم المتقدم أو التشغيل الآلي فقط. CelestAI تعمل من غير أي مفتاح
# بالقواعد الهندسية المدمجة (أوفلاين بالكامل).

# ============================================================================
# الخيار 1: Claude (Anthropic) — الافتراضي
# ============================================================================
# احصل على المفتاح من: https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# بديل: سجّل دخول مرة واحدة وهيتخزّن بروفايل تلقائي، من غير ما تحط مفتاح هنا
#   ant auth login

# ============================================================================
# الخيار 2: أي مزوّد متوافق مع OpenAI — Groq وOpenRouter وTogether وموديل محلي
# ============================================================================
# فعّل المسار ده بدل Claude:
#   CELESTAI_AI_PROVIDER=groq
#
# مثال بـ Groq (فيه مستوى مجاني — سجّل على https://console.groq.com واعمل مفتاح):
#   CELESTAI_AI_PROVIDER=groq
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   CELESTAI_AI_MODEL=llama-3.3-70b-versatile   # شوف قائمة الموديلات المتاحة في console.groq.com
#
# مثال بـ OpenRouter (بوابة على موديلات كتير، فيها خيارات مجانية):
#   CELESTAI_AI_PROVIDER=openrouter
#   OPENAI_API_KEY=sk-or-...
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   CELESTAI_AI_MODEL=openrouter/free
#
# مثال بـ Gemini Free Tier:
#   CELESTAI_AI_PROVIDER=gemini
#   OPENAI_API_KEY=...
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   CELESTAI_AI_MODEL=gemini-3.8-flash
#
# مثال بموديل محلي عن طريق خادم متوافق مع OpenAI (زي Ollama):
#   CELESTAI_AI_PROVIDER=ollama
#   OPENAI_API_KEY=ollama          # أي قيمة، مش بتتحقق منها محليًا
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   CELESTAI_AI_MODEL=gpt-oss:20b

# ⚠️ لاحظ إن أسماء الموديلات بتتغيّر بمرور الوقت — ارجع لصفحة المزوّد نفسه وشوف
#    القائمة الحالية بدل ما تعتمد على الأمثلة دي حرفيًا.
